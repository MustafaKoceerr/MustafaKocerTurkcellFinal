<?xml version="1.0" encoding="utf-8"?><!-- res/layout/fragment_cart.xml (StateLayout ile refactor) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".presentation.feature_cart.CartFragment">

    <!-- StateLayout ana içerik alanı -->
    <com.example.mustafakocer.presentation.common.StateLayout
        android:id="@+id/state_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:emptyIcon="@drawable/ic_empty_cart_24"
        app:emptySubtitle="@string/cart_empty_subtitle"
        app:emptyTitle="@string/cart_empty_title"
        app:errorIcon="@drawable/ic_cloud_off_24"

        app:layout_constraintBottom_toTopOf="@id/cardSummary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- İçerik: RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/home_content_margin"
            android:paddingTop="@dimen/home_content_margin_top"
            android:paddingEnd="@dimen/home_content_margin"
            android:paddingBottom="@dimen/recycler_view_bottom_padding"
            tools:itemCount="4" />
    </com.example.mustafakocer.presentation.common.StateLayout>

    <!-- Alt özet kartı: StateLayout DIŞINDA -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/cart_summary_corner_radius"
        app:cardElevation="@dimen/cart_summary_elevation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/cart_summary_min_height"
            android:paddingStart="@dimen/cart_summary_padding"
            android:paddingTop="@dimen/cart_summary_padding_top"
            android:paddingEnd="@dimen/cart_summary_padding"
            android:paddingBottom="@dimen/cart_summary_padding_bottom">

            <!-- Etiket (ID korunur) -->
            <TextView
                android:id="@+id/txtTotalLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cart_summary_total_label"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toStartOf="@id/btnCheckout"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="8dp" />

            <!-- Toplam (ID korunur) -->
            <TextView
                android:id="@+id/txtTotalPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnCheckout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTotalLabel"
                app:layout_goneMarginEnd="8dp"
                tools:text="$124.50" />

            <!-- Ödeme butonu (ID korunur) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckout"
                style="?attr/materialButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_checkout"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="@string/cart_checkout_button"
                app:icon="@drawable/ic_lock_24"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/cart_checkout_icon_padding"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

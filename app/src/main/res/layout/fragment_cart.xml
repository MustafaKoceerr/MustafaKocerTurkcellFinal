<?xml version="1.0" encoding="utf-8"?>
<!-- CartFragment -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".presentation.feature_cart.CartFragment">

    <!-- Sepet ürünleri -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cartRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/home_content_margin"
        android:paddingEnd="@dimen/home_content_margin"
        android:paddingTop="@dimen/home_content_margin_top"
        android:paddingBottom="@dimen/recycler_view_bottom_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardSummary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:itemCount="4" />

    <!-- Yüklenme (ID korunur) -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressbar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:indicatorSize="32dp"
        app:trackThickness="3dp"
        app:indicatorInset="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!-- Boş sepet durumu (ID korunur) -->
    <TextView
        android:id="@+id/txtEmptyCart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/empty_drawable_padding"
        android:gravity="center"
        android:text="@string/cart_empty_message"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:drawableTopCompat="@drawable/ic_empty_cart_24"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardSummary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35"
        tools:visibility="gone"
        android:drawableTint="?attr/colorOnSurfaceVariant" />

    <!-- Alt özet kartı: toplam + ödeme -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/cart_summary_elevation"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardUseCompatPadding="false"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="@dimen/cart_summary_corner_radius">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/cart_summary_min_height"
            android:paddingStart="@dimen/cart_summary_padding"
            android:paddingEnd="@dimen/cart_summary_padding"
            android:paddingTop="@dimen/cart_summary_padding_top"
            android:paddingBottom="@dimen/cart_summary_padding_bottom">

            <!-- Etiket (ID korunur) -->
            <TextView
                android:id="@+id/txtTotalLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cart_summary_total_label"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnCheckout"
                app:layout_constraintHorizontal_bias="0"
                app:layout_goneMarginEnd="8dp" />

            <!-- Toplam (ID korunur) -->
            <TextView
                android:id="@+id/txtTotalPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/txtTotalLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnCheckout"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_goneMarginEnd="8dp"
                tools:text="$124.50" />

            <!-- Ödeme butonu (ID korunur) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckout"
                style="?attr/materialButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/cart_checkout_button"
                android:contentDescription="@string/cd_checkout"
                app:icon="@drawable/ic_lock_24"
                app:iconPadding="@dimen/cart_checkout_icon_padding"
                app:iconGravity="textStart"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

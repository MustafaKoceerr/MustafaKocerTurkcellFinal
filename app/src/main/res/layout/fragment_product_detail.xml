<?xml version="1.0" encoding="utf-8"?><!-- fragment_product_detail.xml (StateLayout ile refactor) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.example.mustafakocer.presentation.common.StateLayout
        android:id="@+id/state_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/cardActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:errorIcon="@drawable/ic_cloud_off_24">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/pd_scroll_bottom_inset">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/pagerContainer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/pagerImages"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_pd_image_bottom_scrim" />

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/pagerIndicator"
                        style="@style/Widget.App.DotsTabLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="10dp"
                        app:tabMode="scrollable" />
                </FrameLayout>

                <!-- % indirim rozeti -->
                <TextView
                    android:id="@+id/badgeDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/badge_edge_margin"
                    android:layout_marginTop="@dimen/badge_edge_margin"
                    android:background="@drawable/bg_badge_label"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:paddingStart="@dimen/badge_h"
                    android:paddingTop="@dimen/badge_v"
                    android:paddingEnd="@dimen/badge_h"
                    android:paddingBottom="@dimen/badge_v"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@id/pagerContainer"
                    app:layout_constraintTop_toTopOf="@id/pagerContainer"
                    tools:text="%18"
                    tools:visibility="visible" />

                <!-- Stok rozeti -->
                <TextView
                    android:id="@+id/badgeStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/badge_edge_margin"
                    android:layout_marginEnd="@dimen/badge_edge_margin"
                    android:background="@drawable/bg_badge_label"
                    android:backgroundTint="?attr/colorTertiaryContainer"
                    android:paddingStart="@dimen/badge_h"
                    android:paddingTop="@dimen/badge_v"
                    android:paddingEnd="@dimen/badge_h"
                    android:paddingBottom="@dimen/badge_v"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="@id/pagerContainer"
                    app:layout_constraintTop_toTopOf="@id/pagerContainer"
                    tools:text="Son 3"
                    tools:visibility="gone" />

                <!-- Başlık + Meta + Rating -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pd_content_margin"
                    android:layout_marginTop="@dimen/pd_block_top"
                    android:layout_marginEnd="@dimen/pd_content_margin"
                    app:cardCornerRadius="@dimen/pd_card_corner_radius"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/pagerContainer"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="@dimen/pd_card_stroke_width">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/pd_card_padding_h"
                        android:paddingTop="@dimen/pd_card_padding_v"
                        android:paddingEnd="@dimen/pd_card_padding_h"
                        android:paddingBottom="@dimen/pd_card_padding_v">

                        <TextView
                            android:id="@+id/txtTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:textAppearance="@style/TextAppearance.App.TitleLarge"
                            android:textColor="?attr/colorOnSurface"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="Apple iPhone 13 Pro Max 256GB Sierra Blue" />

                        <androidx.constraintlayout.helper.widget.Flow
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/pd_meta_chips_top"
                            app:constraint_referenced_ids="chipGroupMeta"
                            app:flow_horizontalGap="8dp"
                            app:flow_verticalGap="2dp"
                            app:flow_wrapMode="chain"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/txtTitle" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleLine="false"
                            tools:ignore="MissingConstraints" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/chipGroupMeta">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_star_24"
                                app:tint="?attr/colorSecondary" />

                            <TextView
                                android:id="@+id/txtRatingValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:textAppearance="@style/TextAppearance.App.LabelSmall"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="4.8 (126)" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Fiyat kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pd_content_margin"
                    android:layout_marginTop="@dimen/pd_block_gap"
                    android:layout_marginEnd="@dimen/pd_content_margin"
                    app:cardCornerRadius="@dimen/pd_card_corner_radius"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardHeader"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="@dimen/pd_card_stroke_width">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/pd_card_padding_h"
                        android:paddingTop="@dimen/pd_card_padding_v"
                        android:paddingEnd="@dimen/pd_card_padding_h"
                        android:paddingBottom="@dimen/pd_card_padding_v">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtDiscountedPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.App.Price"
                                android:textColor="?attr/colorPrimary"
                                android:textStyle="bold"
                                tools:text="₺10.999" />

                            <TextView
                                android:id="@+id/txtOriginalPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/product_original_price_gap_start"
                                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="₺12.999" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtSavings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/pd_savings_top"
                            android:textAppearance="@style/TextAppearance.App.LabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Tasarruf: %15" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Açıklama -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pd_content_margin"
                    android:layout_marginTop="@dimen/pd_block_gap"
                    android:layout_marginEnd="@dimen/pd_content_margin"
                    app:cardCornerRadius="@dimen/pd_card_corner_radius"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardPrice"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="@dimen/pd_card_stroke_width">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/pd_card_padding_h"
                        android:paddingTop="@dimen/pd_card_padding_v"
                        android:paddingEnd="@dimen/pd_card_padding_h"
                        android:paddingBottom="@dimen/pd_card_padding_v">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pd_description_title"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txtDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/pd_desc_top"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleDescription"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/pd_desc_toggle_top"
                            android:contentDescription="@string/pd_read_more"
                            android:text="@string/pd_read_more"
                            app:icon="@drawable/ic_expand_more_24"
                            app:iconGravity="textEnd"
                            app:iconPadding="@dimen/spacing_xsmall" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Yorumlar başlığı + "Tümü" -->
                <LinearLayout
                    android:id="@+id/rowReviewsHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pd_content_margin"
                    android:layout_marginTop="@dimen/pd_block_gap"
                    android:layout_marginEnd="@dimen/pd_content_margin"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardDescription">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pd_reviews_title"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/pd_reviews_see_all"
                        android:text="@string/pd_reviews_see_all" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerReviews"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_content_margin"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rowReviewsHeader"
                    tools:itemCount="3"
                    tools:listitem="@layout/recycler_row_review" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/reviewsRecyclerView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pd_content_margin"
                    android:layout_marginTop="@dimen/pd_list_top_spacing"
                    android:layout_marginEnd="@dimen/pd_content_margin"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rowReviewsHeader"
                    tools:itemCount="2"
                    tools:listitem="@layout/recycler_row_review" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="@dimen/pd_bottom_space"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/reviewsRecyclerView" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </com.example.mustafakocer.presentation.common.StateLayout>

    <!-- Alt sabit aksiyon barı -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardActionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pd_actionbar_margin_h"
        android:layout_marginEnd="@dimen/pd_actionbar_margin_h"
        android:layout_marginBottom="@dimen/pd_actionbar_margin_bottom"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/pd_actionbar_corner_radius"
        app:cardElevation="@dimen/pd_actionbar_elevation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/pd_actionbar_min_height"
            android:paddingStart="@dimen/pd_actionbar_padding_h"
            android:paddingTop="@dimen/pd_actionbar_padding_v"
            android:paddingEnd="@dimen/pd_actionbar_padding_h"
            android:paddingBottom="@dimen/pd_actionbar_padding_v">

            <TextView
                android:id="@+id/txtActionPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Price"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/layoutCartOperations"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="8dp"
                tools:text="₺10.999" />

            <LinearLayout
                android:id="@+id/layoutCartOperations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cart_overlay"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/cart_overlay_hpad"
                android:paddingTop="@dimen/cart_overlay_vpad"
                android:paddingEnd="@dimen/cart_overlay_hpad"
                android:paddingBottom="@dimen/cart_overlay_vpad"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

                <ImageButton
                    android:id="@+id/btnMinus"
                    android:layout_width="@dimen/cart_btn_size"
                    android:layout_height="@dimen/cart_btn_size"
                    android:background="@drawable/ripple_minus"
                    android:contentDescription="@string/cd_decrease"
                    android:scaleType="center"
                    app:srcCompat="@drawable/ic_remove_24"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/txtQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cart_qty_gap"
                    android:layout_marginEnd="@dimen/cart_qty_gap"
                    android:textAppearance="@style/TextAppearance.App.TitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="1" />

                <ImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="@dimen/cart_btn_size"
                    android:layout_height="@dimen/cart_btn_size"
                    android:background="@drawable/ripple_plus"
                    android:contentDescription="@string/cd_increase"
                    android:scaleType="center"
                    app:srcCompat="@drawable/ic_add_24"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToCart"
                style="?attr/materialButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_add_to_cart"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="@dimen/touch_target_48"
                android:minHeight="@dimen/product_add_min_touch"
                android:paddingStart="@dimen/pd_add_hpad"
                android:paddingTop="@dimen/pd_add_vpad"
                android:paddingEnd="@dimen/pd_add_hpad"
                android:paddingBottom="@dimen/pd_add_vpad"
                android:text="@string/product_add_to_cart"
                app:icon="@drawable/ic_add_24"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/product_add_icon_pad"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

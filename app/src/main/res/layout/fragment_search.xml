<?xml version="1.0" encoding="utf-8"?><!-- SearchFragment -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".presentation.feature_product_search.SearchFragment">

    <!-- Arama alanı (ID korunur) -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/search_content_margin"
        android:layout_marginTop="@dimen/search_content_margin_top"
        android:layout_marginEnd="@dimen/search_content_margin"
        android:background="@drawable/bg_search_view"
        android:focusable="true"
        android:iconifiedByDefault="false"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingStart="@dimen/search_field_inner_padding_h"
        android:paddingEnd="@dimen/search_field_inner_padding_h"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:queryHint="@string/search_hint" />

    <!-- (Opsiyonel) Filtreler -->
    <HorizontalScrollView
        android:id="@+id/filtersScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/search_content_margin"
        android:layout_marginTop="@dimen/search_filters_margin_top"
        android:layout_marginEnd="@dimen/search_content_margin"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchView"
        tools:visibility="visible">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            app:selectionRequired="false"
            app:singleLine="true"
            app:singleSelection="false"
            tools:ignore="UselessParent" />
    </HorizontalScrollView>

    <!-- *** YENİ: Idle state (henüz arama yapılmadı) *** -->
    <LinearLayout
        android:id="@+id/stateIdleGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/state_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/searchView"
        app:layout_constraintStart_toStartOf="@id/searchView"
        app:layout_constraintTop_toBottomOf="@id/filtersScroll"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/imgIdleSearch"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.12"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search_24"
            app:tint="?attr/colorOnSurface" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtIdleMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/state_subtitle_top"
            android:text="@string/search_idle_message"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Aramaya başlamak için yazmaya başlayın" />
    </LinearLayout>

    <!-- Sonuç listesi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/home_content_margin"
        android:paddingTop="@dimen/search_results_padding_top"
        android:paddingEnd="@dimen/home_content_margin"
        android:paddingBottom="@dimen/search_results_padding_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/searchView"
        app:layout_constraintStart_toStartOf="@id/searchView"
        app:layout_constraintTop_toBottomOf="@id/filtersScroll"
        tools:itemCount="8"
        tools:listitem="@layout/recyler_row_product_grid" />

    <!-- Loading -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressbar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:indicatorInset="8dp"
        app:indicatorSize="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackThickness="3dp"
        tools:visibility="visible" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/stateEmptyGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/state_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/searchView"
        app:layout_constraintStart_toStartOf="@id/searchView"
        app:layout_constraintTop_toBottomOf="@id/filtersScroll"
        tools:visibility="gone">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_empty_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/state_subtitle_top"
            android:text="@string/search_empty_subtitle"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Error state -->
    <LinearLayout
        android:id="@+id/stateErrorGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/state_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/searchView"
        app:layout_constraintStart_toStartOf="@id/searchView"
        app:layout_constraintTop_toBottomOf="@id/filtersScroll"
        tools:visibility="gone">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_error_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/state_action_top"
            android:contentDescription="@string/cd_retry"
            android:text="@string/action_retry" />
    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabScrollTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fab_margin"
        android:contentDescription="@string/cd_scroll_to_top"
        android:text="@string/action_scroll_to_top"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:visibility="gone"
        app:backgroundTint="?attr/colorTertiaryContainer"
        app:icon="@drawable/ic_arrow_upward_24"
        app:iconTint="?attr/colorOnTertiaryContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>

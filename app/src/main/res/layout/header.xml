<?xml version="1.0" encoding="utf-8"?>
<!-- NavigationView header (stacked: avatar üstte, ad & e-posta altta) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorPrimaryContainer"
    android:padding="@dimen/header_padding">

    <!-- Avatar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewHeader"
        android:layout_width="@dimen/header_avatar_size"
        android:layout_height="@dimen/header_avatar_size"
        android:layout_marginBottom="@dimen/header_spacing"
        app:cardCornerRadius="@dimen/header_avatar_radius"
        app:cardElevation="@dimen/header_avatar_elevation"
        app:strokeColor="?attr/colorOnPrimaryContainer"
        app:strokeWidth="@dimen/header_avatar_stroke"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/imgViewHeader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_header_profile_image"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/avatars" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Ad Soyad (avatarın altında, tam genişlik) -->
    <TextView
        android:id="@+id/txtNameHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/header_spacing_small"
        app:layout_constraintTop_toBottomOf="@id/cardViewHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Mustafa Koçer" />

    <!-- E-posta (adın altında, tam genişlik) -->
    <TextView
        android:id="@+id/txtMailHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/header_spacing_xsmall"
        app:layout_constraintTop_toBottomOf="@id/txtNameHeader"
        app:layout_constraintStart_toStartOf="@id/txtNameHeader"
        app:layout_constraintEnd_toEndOf="@id/txtNameHeader"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="mustafa.kocer@example.com" />

</androidx.constraintlayout.widget.ConstraintLayout>

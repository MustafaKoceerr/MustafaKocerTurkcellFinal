<?xml version="1.0" encoding="utf-8"?>
<!-- OrdersFragment (SwipeRefreshLayout kaldırıldı) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".presentation.feature_orders.OrdersFragment">

    <!-- Sipariş listesi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/orderRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/orders_content_inset"
        android:paddingEnd="@dimen/orders_content_inset"
        android:paddingTop="@dimen/orders_content_inset_top"
        android:paddingBottom="@dimen/orders_content_inset_bottom"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/recycler_row_order"
        tools:itemCount="6" />

    <!-- Yüklenme göstergesi (ID korunur) -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressbar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:indicatorSize="32dp"
        app:trackThickness="3dp"
        app:indicatorInset="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!-- Boş durum metni (ID korunur) -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txtEmptyOrders"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:drawablePadding="@dimen/empty_drawable_padding"
        android:gravity="center"
        android:text="@string/empty_orders_message"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35"
        tools:visibility="gone"
        android:drawableTint="?attr/colorOnSurfaceVariant"
        app:drawableTopCompat="@drawable/ic_receipt_long_24" />

    <!-- Hata durumu -->
    <LinearLayout
        android:id="@+id/stateErrorGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/state_padding"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:text="@string/orders_error_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/state_action_top"
            android:text="@string/action_retry"
            android:contentDescription="@string/cd_retry" />
    </LinearLayout>

    <!-- En üste dön FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabScrollTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fab_margin"
        android:text="@string/action_scroll_to_top"
        android:contentDescription="@string/cd_scroll_to_top"
        app:icon="@drawable/ic_arrow_upward_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:backgroundTint="?attr/colorTertiaryContainer"
        app:iconTint="?attr/colorOnTertiaryContainer"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:visibility="gone"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>

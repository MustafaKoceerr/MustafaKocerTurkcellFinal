<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/state_prompt_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xlarge">

    <ImageView
        android:id="@+id/state_prompt_icon"
        android:layout_width="@dimen/state_icon_size"
        android:layout_height="@dimen/state_icon_size"
        android:alpha="0.5"
        android:contentDescription="@null"
        app:tint="?attr/colorOnSurfaceVariant"
        tools:src="@drawable/ic_search_24" />

    <TextView
        android:id="@+id/state_prompt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:text="@string/state_prompt_default_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="Aramaya Başlayın" />

    <TextView
        android:id="@+id/state_prompt_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_micro"
        android:gravity="center"
        android:text="@string/state_prompt_default_subtitle"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="En az 3 karakter girerek arama yapabilirsiniz." />

</LinearLayout>

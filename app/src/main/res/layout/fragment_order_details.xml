<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/fragment_order_details.xml (StateLayout ile refactor) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".presentation.feature_orders.OrderDetailsFragment">

    <!-- StateLayout ana kapsayıcı -->
    <com.example.mustafakocer.presentation.common.StateLayout
        android:id="@+id/state_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:errorIcon="@drawable/ic_cloud_off_24">

        <!-- İçerik: NestedScrollView artık StateLayout'ın çocuğu -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="?attr/colorSurface">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Özet kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOrderSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_content_margin"
                    android:layout_marginEnd="@dimen/od_content_margin"
                    android:layout_marginTop="@dimen/od_content_margin"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="@dimen/od_card_corner_radius"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="@dimen/od_card_stroke_width"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/od_card_padding"
                        android:paddingEnd="@dimen/od_card_padding"
                        android:paddingTop="@dimen/od_card_padding_top"
                        android:paddingBottom="@dimen/od_card_padding_bottom">

                        <!-- Başlık (ID mevcut) -->
                        <TextView
                            android:id="@+id/txtSummaryTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/order_details_summary_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textColor="?attr/colorOnSurface"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/chipOrderStatus"
                            app:layout_goneMarginEnd="8dp" />

                        <!-- Sipariş durumu (Assist Chip) -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipOrderStatus"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/order_status_preparing"
                            android:checkable="false"
                            app:chipIcon="@drawable/ic_schedule_24"
                            app:chipIconTint="?attr/colorOnSurfaceVariant"
                            app:chipStartPadding="6dp"
                            app:layout_constraintTop_toTopOf="@id/txtSummaryTitle"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Sipariş ID -->
                        <TextView
                            android:id="@+id/txtOrderIdLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/od_row_spacing_sm"
                            android:text="@string/order_details_order_id_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            app:layout_constraintTop_toBottomOf="@id/txtSummaryTitle"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/txtOrderId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            app:layout_constraintBaseline_toBaselineOf="@id/txtOrderIdLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            tools:text="#24" />

                        <!-- Tarih -->
                        <TextView
                            android:id="@+id/txtOrderDateLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/od_row_spacing_xs"
                            android:text="@string/order_details_date_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            app:layout_constraintTop_toBottomOf="@id/txtOrderIdLabel"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/txtOrderDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            app:layout_constraintBaseline_toBaselineOf="@id/txtOrderDateLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            tools:text="11 Ağu 2025, 13:20" />

                        <!-- Ürün adedi -->
                        <TextView
                            android:id="@+id/txtItemCountLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/od_row_spacing_xs"
                            android:text="@string/order_details_items_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            app:layout_constraintTop_toBottomOf="@id/txtOrderDateLabel"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/txtItemCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            app:layout_constraintBaseline_toBaselineOf="@id/txtItemCountLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            tools:text="7 ürün" />

                        <!-- Toplam tutar -->
                        <TextView
                            android:id="@+id/txtTotalAmountLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/od_row_spacing_sm"
                            android:text="@string/order_details_total_amount_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            app:layout_constraintTop_toBottomOf="@id/txtItemCountLabel"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/txtTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            app:layout_constraintBaseline_toBaselineOf="@id/txtTotalAmountLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            tools:text="₺1.594,33" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ürünler başlığı -->
                <TextView
                    android:id="@+id/txtProductsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_content_margin"
                    android:layout_marginTop="@dimen/od_section_spacing"
                    android:text="@string/order_details_products_section_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    app:layout_constraintTop_toBottomOf="@id/cardOrderSummary"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Ürünler listesi -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/productsRecyclerView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_content_margin"
                    android:layout_marginEnd="@dimen/od_content_margin"
                    android:layout_marginTop="@dimen/od_list_top_spacing"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/od_list_bottom_padding"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/txtProductsLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:itemCount="5" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </com.example.mustafakocer.presentation.common.StateLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

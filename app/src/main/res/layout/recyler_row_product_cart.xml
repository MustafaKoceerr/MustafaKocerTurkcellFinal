<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/product_item_margin"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/product_item_corner_radius"
    app:cardElevation="@dimen/product_item_elevation"
    app:cardUseCompatPadding="false"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="@dimen/product_item_stroke_width">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/product_content_padding">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgProduct"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/cd_product_image"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <!-- Başlık -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_marginEnd="@dimen/spacing_small"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.App.TitleSmall"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toStartOf="@id/txtLineTotal"
            app:layout_constraintStart_toEndOf="@id/imgProduct"
            app:layout_constraintTop_toTopOf="@id/imgProduct"
            tools:text="Apple iPhone 13 Pro Max 256GB Sierra Blue" />

        <!-- Satır Toplamı -->
        <TextView
            android:id="@+id/txtLineTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Price"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtTitle"
            tools:text="₺21.998" />

        <!-- Birim Fiyat -->
        <TextView
            android:id="@+id/txtPricePerUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="@id/txtLineTotal"
            app:layout_constraintTop_toBottomOf="@id/txtLineTotal"
            tools:text="₺10.999 / adet" />

        <!-- − qty + -->
        <LinearLayout
            android:id="@+id/layoutCartOperations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_cart_overlay"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/cart_overlay_hpad"
            android:paddingTop="@dimen/cart_overlay_vpad"
            android:paddingEnd="@dimen/cart_overlay_hpad"
            android:paddingBottom="@dimen/cart_overlay_vpad"
            app:layout_constraintBottom_toBottomOf="@id/imgProduct"
            app:layout_constraintStart_toStartOf="@id/txtTitle"
            app:layout_constraintTop_toBottomOf="@id/txtTitle"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/btnMinus"
                android:layout_width="@dimen/cart_btn_size"
                android:layout_height="@dimen/cart_btn_size"
                android:contentDescription="@string/cd_decrease"
                android:background="@drawable/ripple_minus"
                android:scaleType="center"
                app:srcCompat="@drawable/ic_remove_24"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/txtQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cart_qty_gap"
                android:layout_marginEnd="@dimen/cart_qty_gap"
                android:textAppearance="@style/TextAppearance.App.TitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="2" />

            <ImageButton
                android:id="@+id/btnPlus"
                android:layout_width="@dimen/cart_btn_size"
                android:layout_height="@dimen/cart_btn_size"
                android:background="@drawable/ripple_plus"
                android:contentDescription="@string/cd_increase"
                android:scaleType="center"
                app:srcCompat="@drawable/ic_add_24"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- KALDIR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemove"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:contentDescription="@string/cd_remove_item"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/cart_remove"
            android:textColor="?attr/colorError"
            app:icon="@drawable/ic_delete_24"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_xsmall"
            app:iconTint="?attr/colorError"
            app:layout_constraintBottom_toBottomOf="@id/imgProduct"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layoutCartOperations"
            app:layout_constraintTop_toBottomOf="@id/txtPricePerUnit" />

        <!-- İndirim etiketi (opsiyonel) -->
        <TextView
            android:id="@+id/badgeDiscount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/badge_edge_margin"
            android:layout_marginTop="@dimen/badge_edge_margin"
            android:background="@drawable/bg_badge_label"
            android:backgroundTint="?attr/colorPrimaryContainer"
            android:paddingStart="@dimen/badge_h"
            android:paddingTop="@dimen/badge_v"
            android:paddingEnd="@dimen/badge_h"
            android:paddingBottom="@dimen/badge_v"
            android:textAppearance="@style/TextAppearance.App.LabelSmall"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/imgProduct"
            app:layout_constraintTop_toTopOf="@id/imgProduct"
            tools:text="%15"
            tools:visibility="gone" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

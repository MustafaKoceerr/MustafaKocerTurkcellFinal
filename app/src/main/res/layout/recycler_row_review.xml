<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="false"
    android:focusable="false"
    app:cardUseCompatPadding="false"
    app:cardCornerRadius="@dimen/pd_review_corner_radius"
    app:cardElevation="@dimen/pd_review_elevation"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pd_review_padding_h"
        android:paddingEnd="@dimen/pd_review_padding_h"
        android:paddingTop="@dimen/pd_review_padding_v"
        android:paddingBottom="@dimen/pd_review_padding_v">

        <TextView
            android:id="@+id/txtReviewer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            tools:text="Ahmet K." />

        <TextView
            android:id="@+id/txtReviewDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="12 Ağu 2025" />

        <TextView
            android:id="@+id/txtReviewComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pd_review_comment_top"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            tools:text="Ürün beklediğimden iyi. Kargo hızlıydı." />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
